{
  "manifest_version": 3,
  "name": "UmSpec - SPeCTRUM Course Exporter",
  "version": "2.0.2",
  "key": "",
  "description": "Export UM SPeCTRUM courses to ZIP, sync selected materials to Google Drive, and review dates for Google Calendar.",
  "background": {
    "service_worker": "background/worker.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "UmSpec Course Exporter",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://spectrum.um.edu.my/*"
      ],
      "js": [
        "lib/jszip.min.js",
        "shared/sync-core.js",
        "shared/calendar-core.js",
        "shared/announcement-core.js",
        "content/materials.js",
        "content/content.js",
        "content/student-sync.js"
      ],
      "css": [
        "content/content.css",
        "content/student-sync.css"
      ],
      "run_at": "document_end"
    }
  ],
  "host_permissions": [
    "https://spectrum.um.edu.my/*"
  ],
  "optional_host_permissions": [
    "https://www.googleapis.com/*"
  ],
  "permissions": [
    "storage",
    "identity",
    "activeTab",
    "scripting"
  ],
  "oauth2": {
    "client_id": "604535116312-6hmmkud4h0ruhv2d6uh7vs4lfru0bam9.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "https://www.googleapis.com/auth/drive.file",
      "https://www.googleapis.com/auth/calendar.app.created",
      "https://www.googleapis.com/auth/calendar.calendarlist.readonly"
    ]
  }
}
