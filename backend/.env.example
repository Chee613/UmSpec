# UmSpec Gemini API Proxy - Environment Variables
# Copy this file to .env and insert your real Gemini API keys

# Gemini API Keys for load balancing (Comma-separated for round-robin rotation & 429 failover)
GEMINI_API_KEYS=AIzaSyA_key1_here,AIzaSyB_key2_here,AIzaSyC_key3_here

# Primary Model (Ultra-fast, cost-effective proforma extraction)
PRIMARY_MODEL=gemini-3.5-flash-lite

# Fallback Model (Triggered if all keys hit rate limits or 429 on primary model)
FALLBACK_MODEL=gemini-3.1-flash-lite

# Node Server Port (Default: 3000)
PORT=3000
